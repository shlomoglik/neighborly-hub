# Server-only PostgreSQL connection. Never prefix with NEXT_PUBLIC_.
DATABASE_URL=postgresql://neighborly:replace-me@localhost:5432/neighborly

# Server-only deployment migration connection: direct or session mode, never transaction pooling.
# Production and exact staging-branch Preview use independent credentials.
# Never share Production credentials with Preview.
MIGRATION_DATABASE_URL=
# Optional public (default), or staging with dedicated schema/roles.
DATABASE_SCHEMA=public

# Auth requires DATABASE_URL, BETTER_AUTH_URL and BETTER_AUTH_SECRET.
# Exact public origin; use HTTPS in production. No paths or wildcard origins.
BETTER_AUTH_URL=http://localhost:3000
# Generate once with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Optional Google OAuth Web application; callback: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional email verification and password recovery. Both are required to enable public signup.
# Use a verified Resend sending domain; AUTH_EMAIL_FROM is a bare email address.
RESEND_API_KEY=
AUTH_EMAIL_FROM=
