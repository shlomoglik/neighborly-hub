# Server-only PostgreSQL connection. Never prefix with NEXT_PUBLIC_.
DATABASE_URL=postgresql://neighborly:replace-me@localhost:5432/neighborly

# Server-only deployment migration connection: direct or session mode, never transaction pooling.
# Set ONLY in Vercel Production; do not share Production credentials with Preview.
MIGRATION_DATABASE_URL=

# Auth requires DATABASE_URL, BETTER_AUTH_URL and BETTER_AUTH_SECRET.
# Exact public origin; use HTTPS in production. No paths or wildcard origins.
BETTER_AUTH_URL=http://localhost:3000
# Generate once with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Optional Google OAuth Web application (both credentials or neither); callback: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional server-only email delivery (both or neither). Use a verified Resend sender domain.
# Enables email registration/verification and password recovery; password login works without it.
RESEND_API_KEY=
AUTH_EMAIL_FROM=
