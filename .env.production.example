# Copy to .env.production.local; ONLY a SELECT-only PostgreSQL role.
# Interactive auth and write operations may fail; use for restricted diagnostics only.
DATABASE_URL=
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DATABASE_READ_ONLY=true
ALLOW_PRODUCTION_DEBUG=false

# Optional: public email signup, verification and password recovery.
RESEND_API_KEY=
AUTH_EMAIL_FROM=
